[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://ui/date_header.gd" id="header"]
[ext_resource type="Script" path="res://ui/pixel_icon.gd" id="icon"]
[ext_resource type="Script" path="res://ui/affinity_meter.gd" id="meter"]
[ext_resource type="Font" path="res://ui/pixel.ttf" id="pixel"]
[ext_resource type="Font" path="res://ui/mono.tres" id="mono"]

[node name="DateHeader" type="HBoxContainer"]
custom_minimum_size = Vector2(0, 52)
theme_override_constants/separation = 16
script = ExtResource("header")

[node name="Emblem" type="Control" parent="."]
custom_minimum_size = Vector2(55, 48)
layout_mode = 2
mouse_filter = 2
script = ExtResource("icon")

[node name="Brand" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = -2
alignment = 1

[node name="Title" type="HBoxContainer" parent="Brand"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Shift" type="Label" parent="Brand/Title"]
layout_mode = 2
theme_override_fonts/font = ExtResource("pixel")
theme_override_font_sizes/font_size = 41
text = "SHIFT"

[node name="Club" type="Label" parent="Brand/Title"]
layout_mode = 2
theme_override_fonts/font = ExtResource("pixel")
theme_override_font_sizes/font_size = 41
theme_override_colors/font_color = Color(1, 0.506, 0.667, 1)
text = "CLUB"

[node name="Subtitle" type="Label" parent="Brand"]
layout_mode = 2
theme_override_fonts/font = ExtResource("mono")
