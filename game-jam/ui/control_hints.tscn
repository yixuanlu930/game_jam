theme_override_colors/font_color = Color(0.83, 0.79, 0.86, 1)
theme_override_styles/normal = SubResource("Key")
text = "SHIFT"

[node name="Text" type="Label" parent="ShiftHint"]
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.69, 0.66, 0.73, 1)
text = "Rechazar cita"

[node name="WaiterHint" type="HBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 7

[node name="Key" type="Label" parent="WaiterHint"]
