[node name="Text" type="Label" parent="ContinueHint"]
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.69, 0.66, 0.73, 1)
text = "Continuar"

[node name="ShiftHint" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 7

[node name="Key" type="Label" parent="ShiftHint"]
theme_override_fonts/font = ExtResource("mono")
