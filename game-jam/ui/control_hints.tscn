[node name="Space" type="Control" parent="."]
size_flags_horizontal = 3
mouse_filter = 2

[node name="Status" type="HBoxContainer" parent="."]
theme_override_constants/separation = 8

[node name="Lamp" type="ColorRect" parent="Status"]
custom_minimum_size = Vector2(6, 6)
size_flags_vertical = 4
mouse_filter = 2
color = Color(0.53, 0.88, 0.83, 1)

[node name="Turn" type="Label" parent="Status"]
