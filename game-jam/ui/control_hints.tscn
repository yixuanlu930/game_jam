[gd_scene load_steps=4 format=3]

[ext_resource type="Font" path="res://ui/mono.tres" id="mono"]
[ext_resource type="Script" path="res://ui/control_hints.gd" id="script"]

[sub_resource type="StyleBoxFlat" id="Key"]
bg_color = Color(0.1137, 0.1098, 0.148, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 2
border_color = Color(0.2745, 0.251, 0.302, 1)
content_margin_left = 5
content_margin_right = 5
content_margin_top = 1
content_margin_bottom = 1

[node name="ControlHints" type="HBoxContainer"]
theme_override_constants/separation = 18
script = ExtResource("script")

[node name="RespondHint" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 7

[node name="Key" type="Label" parent="RespondHint"]
theme_override_fonts/font = ExtResource("mono")
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.83, 0.79, 0.86, 1)
theme_override_styles/normal = SubResource("Key")
text = "1–4"

[node name="Text" type="Label" parent="RespondHint"]
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.69, 0.66, 0.73, 1)
text = "Responder"

[node name="ContinueHint" type="HBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 7

[node name="Key" type="Label" parent="ContinueHint"]
theme_override_fonts/font = ExtResource("mono")
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.83, 0.79, 0.86, 1)
theme_override_styles/normal = SubResource("Key")
